rules_version = '2';

// Sappadu keeps everything in one well-known document — there's no per-person
// profile split (unlike the workout app's per-profile documents), so this is
// intentionally a single locked-down path rather than a per-user pattern.
// Anonymous auth (see firebase-sync.js) exists ONLY to satisfy the `request.auth
// != null` check below — it does not partition data, every signed-in device
// (anonymous or not) shares the same document.
//
// To use: Firebase console -> Firestore Database -> Rules -> paste this in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /appState/sappadu {
      allow read, write: if request.auth != null;
    }
    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
