rules_version = '2';

// Sappadu keeps one Firestore document per profile — sappaduState/aswath and
// sappaduState/surekaa — so the two of you sync completely independently,
// never seeing or overwriting each other's data. A separate collection name
// (not `appState`) is used deliberately, in case the same Firebase project
// ends up backing the workout app too, which uses `appState/{profileId}`.
//
// Anonymous auth (see firebase-sync.js) exists ONLY to satisfy the
// `request.auth != null` check below — it does not partition data; both
// profiles are reachable by any signed-in (including anonymous) device,
// same as the workout app's model.
//
// To use: Firebase console -> Firestore Database -> Rules -> paste this in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sappaduState/{profileId} {
      allow read, write: if request.auth != null && profileId in ['aswath', 'surekaa'];
    }
    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
